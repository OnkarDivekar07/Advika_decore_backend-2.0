# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (MongoDB, via Prisma) ---
DATABASE_URL=mongodb://user:password@localhost:27017/backend_2_0

# --- Redis (OTP store, rate limiting, job queues, page caching) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-secret

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# --- Delivery pricing (optional) ---
# Flat delivery-charge rule (src/constants/pricing.js): free at/above the
# threshold, a flat fee below it. Both default to the values below if left
# unset, so nothing needs to change for existing deployments. Update these
# (not the code) to change the rule — the frontend fetches the live values
# from GET /api/shipping/delivery-config rather than hardcoding its own
# copy, so a change here takes effect on the frontend after a backend
# restart, with no separate frontend deploy needed.
FREE_DELIVERY_THRESHOLD=600
DELIVERY_CHARGE=49

# Which payment gateway adapter to use (see src/modules/payment/gateways) -
# optional, defaults to razorpay, the only adapter that exists today.
PAYMENT_GATEWAY=razorpay

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Secret configured in Razorpay Dashboard > Settings > Webhooks (NOT the same as the API key secret)
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- MSG91 (OTP delivery) ---
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-msg91-otp-template-id
# Order-confirmation SMS (MSG91 Flow API — a separate DLT-registered
# template from the OTP one above). Optional: leave unset and the
# confirmation SMS is skipped with a logged warning, no error, no impact
# on the order itself — see notification.service.js.
MSG91_ORDER_CONFIRMATION_FLOW_ID=

# --- AWS S3 (legacy — no longer used for new uploads) ---
# Kept only because existing product/banner images already stored in this
# bucket keep resolving via their saved URLs; new uploads go to Cloudflare
# R2 below. Safe to remove once nothing in the database still points here.
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
BUCKET_NAME=your-s3-bucket-name

# --- Cloudflare R2 (image uploads) --- see src/services/external/AWSUploads.js
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
# Public-facing custom domain bound to the bucket in the Cloudflare
# dashboard (R2 has no public URL of its own without one).
R2_PUBLIC_URL=https://media.yourdomain.com

# --- Delhivery (shipping) ---
# Get your API token from https://one.delhivery.com (API Setup page) and
# your registered pickup location name / seller name from your Delhivery
# account setup — see DelhiveryClient.js.
DELHIVERY_API_TOKEN=your-delhivery-api-token
DELHIVERY_BASE_URL=https://track.delhivery.com
DELHIVERY_PICKUP_LOCATION_NAME=your-registered-pickup-location-name
DELHIVERY_SELLER_NAME=your-registered-seller-name
DELHIVERY_PICKUP_PINCODE=your-warehouse-pincode
# Only needed if/once Delhivery signs webhook payloads — see
# DelhiveryClient.js's verifyWebhookSignature note.
DELHIVERY_WEBHOOK_SECRET=

# --- Error tracking (optional) ---
# Leave unset to disable Sentry entirely (no-op, safe for local dev/CI).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# --- Logging (optional) ---
# error | warn | info | http | debug. Defaults to 'debug' in development,
# 'info' in production.
LOG_LEVEL=
