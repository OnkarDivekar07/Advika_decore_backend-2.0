# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (MongoDB, via Prisma) ---
DATABASE_URL=mongodb://user:password@localhost:27017/backend_2_0

# --- Redis (OTP store, rate limiting, job queues, page caching) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-secret

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# --- Delivery pricing (optional) ---
# Flat delivery-charge rule (src/constants/pricing.js): free at/above the
# threshold, a flat fee below it. Both default to the values below if left
# unset, so nothing needs to change for existing deployments. Update these
# (not the code) to change the rule — the frontend fetches the live values
# from GET /api/shipping/delivery-config rather than hardcoding its own
# copy, so a change here takes effect on the frontend after a backend
# restart, with no separate frontend deploy needed.
FREE_DELIVERY_THRESHOLD=600
DELIVERY_CHARGE=49

# Which payment gateway adapter to use (see src/modules/payment/gateways) -
# optional, defaults to razorpay, the only adapter that exists today.
PAYMENT_GATEWAY=razorpay

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Secret configured in Razorpay Dashboard > Settings > Webhooks (NOT the same as the API key secret)
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- MSG91 (OTP delivery) ---
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-msg91-otp-template-id
# Order-confirmation SMS (MSG91 Flow API — a separate DLT-registered
# template from the OTP one above). Optional: leave unset and the
# confirmation SMS is skipped with a logged warning, no error, no impact
# on the order itself — see notification.service.js.
MSG91_ORDER_CONFIRMATION_FLOW_ID=

# --- AWS S3 (image uploads) ---
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
BUCKET_NAME=your-s3-bucket-name

# --- Ekart Logistics (shipping) ---
# Get these from your Ekart dashboard: Settings > API / Developer / Integration
EKART_API_KEY=your-ekart-api-key
EKART_BASE_URL=https://api.ekartlogistics.com
EKART_MERCHANT_ID=your-ekart-merchant-id
EKART_PICKUP_LOCATION_CODE=your-registered-pickup-location-code
EKART_PICKUP_PINCODE=your-warehouse-pincode
# Only needed if/once Ekart signs webhook payloads — see EkartClient.js
EKART_WEBHOOK_SECRET=

# --- Error tracking (optional) ---
# Leave unset to disable Sentry entirely (no-op, safe for local dev/CI).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# --- Logging (optional) ---
# error | warn | info | http | debug. Defaults to 'debug' in development,
# 'info' in production.
LOG_LEVEL=
