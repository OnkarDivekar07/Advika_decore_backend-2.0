// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  draft
  pending
  confirmed
  shipped
  delivered
  cancelled
  returned
}


// Payment lifecycle, in the order an online (Razorpay) payment normally
// moves through it — see payment.service.js for exactly where each
// transition happens:
//
//   pending -> attempted -> [processing ->] paid
//                        \-> failed
//                        \-> cancelled   (customer closed the checkout
//                                         modal before Razorpay had
//                                         anything to report — see
//                                         cancelPaymentAttempt)
//                        \-> timeout     (attempt went stale and was never
//                                         captured — see
//                                         reconcileStalePaymentAttempts)
//                        \-> unknown     (reconciliation couldn't confirm
//                                         either way, e.g. Razorpay was
//                                         unreachable — needs a human look
//                                         rather than a guess)
//
// `pending` is also the terminal state for a draft order that never even
// started a payment attempt. `cod_pending` is COD's own separate terminal
// state (no online attempt is ever made for it). `refunded` is set outside
// this app today (no refund flow exists yet) but is reserved for one.
enum PaymentStatus {
  pending
  attempted
  processing
  paid
  failed
  cancelled
  timeout
  unknown
  refunded
  cod_pending
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  password  String
  role      String   // 'admin' or 'customer'
  phone     String   @unique
  createdAt DateTime @default(now())

  // Relations
  orders         Order[]
  carts          Cart[]
  reviews        Review[]
  contactQueries ContactQuery[]
  addresses      Address[]
  wishlists      Wishlist[]
}


model Product {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  category    String[]
  brand       String
  price       Float
  stock       Int
  images      String[]   // Array of image URLs
  description String
  createdAt   DateTime   @default(now())
  isNewArrival Boolean @default(false)
  isDeleted   Boolean?  @default(false)
  // Relations
  carts       Cart[]     // One product can be in many cart items
  reviews     Review[]   // One product can have many reviews
  orderItems  OrderItem[]
  wishlists   Wishlist[]
}

model Order {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  // `total` remains the grand total (subtotal + deliveryCharge) and is
  // what payment.controller.js/shipping.service.js actually charge —
  // unchanged in meaning, just no longer equal to the item sum alone.
  total      Float
  // Breakdown fields, added alongside `total` rather than replacing it so
  // existing orders (which predate this rule) keep working: both are
  // optional and simply absent on old records. See
  // src/constants/pricing.js for how they're derived.
  subtotal       Float?
  deliveryCharge Float?
  // Discount/coupon placeholder architecture: both fields are optional so
  // existing orders (predating this) keep working unchanged. `discount` is
  // always 0 today (see calculateDiscount in src/constants/pricing.js — no
  // Coupon model/admin management exists yet), but `total` is already wired
  // as subtotal + deliveryCharge - discount everywhere it's computed, so a
  // real coupon system can be dropped in later by making calculateDiscount
  // do real work, without touching how `total` itself is derived or spent
  // (payment.controller.js, shipping.service.js, etc. only ever read `total`).
  discount       Float?  @default(0)
  couponCode     String?
  addressId  String
  address    Address   @relation(fields: [addressId], references: [id])
  payment_order_id String? @unique
  payment_id String?   // Razorpay payment id (pay_xxx) that actually paid this order, set by the webhook
  status     OrderStatus    // e.g. 'pending', 'shipped', 'delivered', 'cancelled'
  paymentStatus PaymentStatus  @default(pending) // 'pending', 'paid', etc.
  orderItems  OrderItem[]
  createdAt  DateTime  @default(now())
  // Optional (rather than a plain required @updatedAt) so existing orders
  // predating this field keep working unchanged — same convention as
  // subtotal/deliveryCharge above. Used by reconcileStalePaymentAttempts
  // (payment.service.js) to find payment attempts that have gone stale.
  updatedAt  DateTime? @updatedAt
}


model Cart {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  updatedAt  DateTime @updatedAt

  // One row per (user, product) — makes "add to cart" an upsert instead of
  // insert-then-hope, and makes it structurally impossible for the same
  // product to appear twice in one user's cart (which duplicate createMany
  // calls, retries, or double-taps could otherwise produce).
  @@unique([userId, productId])
}

// Customer "save for later" list — deliberately separate from Cart (a
// wishlisted item isn't a purchase intent the way a cart line is, and
// carries no quantity). Same "one row per (user, product)" shape as Cart
// for the same reason: it makes adding an already-wishlisted product an
// upsert/no-op instead of a duplicate row, and makes membership a simple
// unique lookup for the frontend's heart-icon toggle state.
model Wishlist {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Review {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  rating     Int      // e.g. 1 to 5
  comment    String
  createdAt  DateTime @default(now())
}

model ContactQuery {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  email   String
  message String

  userId  String?     // Optional, since not all queries may be by registered users
  user    User?       @relation(fields: [userId], references: [id])
}

model OrderItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String
  productId String
  quantity  Int
  price     Float

  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}


model Banner {
  id        String   @id @map("_id") @default(auto()) @db.ObjectId
  imageUrl  String
  linkUrl   String?
  createdAt DateTime @default(now())
}

model Address {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  phone     String
  pincode   String
  city      String
  houseArea String
  // Locality / sector / colony — distinct from `houseArea` (house no.,
  // building, street). Optional at the schema level so pre-existing
  // addresses (created before this field existed) keep working unchanged;
  // enforced as required for new/edited addresses at the validation layer
  // (see user.validation.js).
  area                 String?
  state                String
  landmark             String?
  // Free-text note for the delivery agent (e.g. "leave with security",
  // "call before delivery"). Always optional.
  deliveryInstructions String?
  // Exactly one address per user has this set to true at any time — this
  // invariant is enforced in user.service.js (createAddress/updateAddressById/
  // setDefaultAddressById/deleteAddressById), never left to the client.
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  orders    Order[]

  @@index([userId])
}


// Event-level webhook ledger — deliberately separate from Order's own
// order-level idempotency (payment.service.js's "paymentStatus: { not:
// 'paid' }" guards). That guard only dedupes the side effects of a single
// event *type* against the order's current state; it can't tell two
// deliveries of the exact same webhook event apart from two different
// events that both happen to resolve to a no-op, and it leaves no record of
// what Razorpay actually sent or when. This table is keyed on Razorpay's own
// x-razorpay-event-id header (unique per event — see
// https://razorpay.com/docs/webhooks/best-practices/), so a retried/resent
// delivery of the same event is recognized and skipped before any handler
// logic runs at all, and the raw payload is kept as an audit trail
// independent of whatever the order's row later gets overwritten with.
model WebhookEvent {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  // 'razorpay' today; kept as a field (not hardcoded) so another provider's
  // webhook (e.g. Ekart shipping) could reuse this table later without a
  // schema change — @@unique below is scoped per-source accordingly.
  source      String
  // Razorpay's x-razorpay-event-id header value.
  eventId     String
  eventType   String
  // Denormalized out of `payload` purely so a duplicate/audit lookup
  // doesn't need to inspect the JSON — the payload itself remains the
  // source of truth for these.
  orderId     String?
  paymentId   String?
  payload     Json
  receivedAt  DateTime  @default(now())

  // One record per (source, eventId) — this is what makes a duplicate
  // delivery detectable at all; see handleRazorpayWebhookEvent.
  @@unique([source, eventId])
  @@index([orderId])
}

// --- Shipping module (Ekart Logistics) ---
// No formal Prisma relation to Order is declared here on purpose, so
// adding this doesn't require touching the existing Order model — orderId
// is a plain reference, resolved manually in shipping.service.js.

enum ShipmentStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RTO_INITIATED
  RTO_DELIVERED
  CANCELLED
}

model Shipment {
  id                 String         @id @default(auto()) @map("_id") @db.ObjectId
  orderId            String         @unique // references Order.id
  trackingId         String?        @unique // Ekart tracking ID / AWB number, set once Ekart returns one
  awbNumber          String?
  courierPartner     String         @default("Ekart")
  status             ShipmentStatus @default(CREATED)
  paymentMode        String         // 'COD' | 'PREPAID', copied from the order at creation time
  codAmount          Float          @default(0)
  pickupLocationCode String?
  lastLocation       String?
  // Delivery-by estimate for this shipment. Set from Ekart's create-shipment
  // response at creation time (see createShipmentForOrder), and kept fresh
  // by trackOrderShipment / handleEkartWebhookEvent whenever Ekart returns a
  // refreshed one on a later poll or webhook (e.g. after a delay). Distinct
  // from the pre-shipment `estimatedDays`/`estimatedDeliveryDate` returned by
  // checkServiceability — that's a rough pre-order preview computed from an
  // SLA day-count; this is the real per-shipment estimate once one exists.
  estimatedDeliveryDate DateTime?
  lastSyncedAt       DateTime?
  raw                Json?          // last raw payload received from Ekart, kept for debugging
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}



