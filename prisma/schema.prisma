// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  draft
  pending
  confirmed
  shipped
  delivered
  cancelled
  returned
}

// Payment lifecycle, in the order an online (Razorpay) payment normally
// moves through it — see payment.service.js for exactly where each
// transition happens:
//
//   pending -> attempted -> [processing ->] paid
//                        \-> failed
//                        \-> cancelled   (customer closed the checkout
//                                         modal before Razorpay had
//                                         anything to report — see
//                                         cancelPaymentAttempt)
//                        \-> timeout     (attempt went stale and was never
//                                         captured — see
//                                         reconcileStalePaymentAttempts)
//                        \-> unknown     (reconciliation couldn't confirm
//                                         either way, e.g. Razorpay was
//                                         unreachable — needs a human look
//                                         rather than a guess)
//
// `pending` is also the terminal state for a draft order that never even
// started a payment attempt. `cod_pending` is COD's own separate terminal
// state (no online attempt is ever made for it). `refunded` is set outside
// this app today (no refund flow exists yet) but is reserved for one.
enum PaymentStatus {
  pending
  attempted
  processing
  paid
  failed
  cancelled
  timeout
  unknown
  refunded
  cod_pending
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  password  String
  role      String // 'admin' or 'customer'
  phone     String   @unique
  createdAt DateTime @default(now())

  // --- Advika Auto storefront fields ---------------------------------
  // Captured at signup (Login.dc.html's Step 3 profile — a 2x2 vehicle
  // picker: Truck/Pickup/Tempo/Tractor) and shown on the Account page's
  // Personal Details card (design_handoff_advika_auto/README.md, screen
  // 8). This is also what the README's Roadmap #1 "vehicle-aware
  // fitment" is meant to read from — the product page personalising
  // "✓ Fits your Tata Ace" — so a real value here (not just
  // localStorage, which never survives a device switch) is required for
  // that feature to ever be buildable. Optional: existing users predate
  // this field, and "Skip for now" at signup is a legitimate path that
  // leaves it unset.
  vehicle     String?
  dateOfBirth DateTime?

  // Relations
  orders         Order[]
  carts          Cart[]
  reviews        Review[]
  contactQueries ContactQuery[]
  addresses      Address[]
  wishlists      Wishlist[]
}

model Product {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  category     String[]
  brand        String
  price        Float
  stock        Int
  images       String[] // Array of image URLs
  description  String
  createdAt    DateTime @default(now())
  isNewArrival Boolean  @default(false)
  isDeleted    Boolean? @default(false)

  // --- Advika Auto storefront fields ---------------------------------
  // All optional/additive so every pre-existing product row (and every
  // caller that doesn't send them) keeps working unchanged — see
  // design_handoff_advika_auto/README.md for what each backs on the
  // frontend.
  //
  // Struck-through "was" price shown next to `price` on product cards
  // and the product detail page. Absent (no discount) when null/equal
  // to `price`.
  mrp           Float?
  // Truck/tempo/pickup/tractor electrical system this SKU is wired for
  // — "12V", "24V", or "12V/24V" for a dual-voltage part. Required (at
  // the application/validation layer, not the schema) for lighting and
  // electrical SKUs per the README's "Domain rule: 12V vs 24V" — a
  // wrong-voltage sale is a real returned-order cost, not a cosmetic
  // detail. Left absent for non-electrical accessories (seat covers,
  // mud flaps, steering covers), which render no voltage badge at all.
  voltage       String?
  // Selling unit shown as a "/unit" suffix next to the price on the
  // product detail page (e.g. "₹10/pc") — one of 'pc' (single piece),
  // 'dozen' (12 pc), or 'jodi' (2 pc / a pair). Absent means no suffix
  // is shown at all, same "render nothing rather than fake data" rule
  // as every other optional storefront field on this model.
  unit          String?
  // Key/value spec rows for the product page's Specifications tab
  // (e.g. { "Wattage": "100W", "Lumens": "9,000 lm", "IP Rating":
  // "IP68" }) — order is insertion order, since Mongo/Prisma Json
  // preserves object key order for what the driver actually stores.
  specs         Json?
  // Purchasable variants (e.g. wattage, beam pattern), each with its
  // own price/mrp: [{ label: "Wattage", defaultIndex: 1, options: [
  // { label: "72W", price: 9999, mrp: 12999 }, ... ] }, ...]. Absent
  // means a single-price product — the common case.
  variants      Json?
  // Vehicle-compatibility list grouped by voltage, real model names
  // (never bare vehicle classes — see the README: "Fits trucks" is
  // useless to a buyer, "Fits Tata Signa" closes the sale):
  // { "24V": ["Tata Signa 4825", ...], "12V": [...] }. Drives the
  // product page's "Fits these vehicles" section; a single-voltage
  // product should only ever populate its own key.
  compatibility Json?
  // Pre-aggregated rating (1-5) and review count shown on cards and
  // the product page's title block / reviews tab. Not derived from the
  // Review relation at read time (no aggregation query on every
  // product fetch) — kept in sync by whatever writes a new Review,
  // same tradeoff most storefronts make for list-page performance.
  rating        Float?
  reviewCount   Int?     @default(0)
  // Feeds the "BEST SELLER" flag on the product page and landing's
  // best-sellers rail — set by admins/merchandising, not computed.
  isBestSeller  Boolean? @default(false)

  // Relations
  carts      Cart[] // One product can be in many cart items
  reviews    Review[] // One product can have many reviews
  orderItems OrderItem[]
  wishlists  Wishlist[]

  // getAllProducts (product.service.js) always starts from
  // `isDeleted: false` and then commonly narrows by category/isNewArrival/
  // isBestSeller/brand/price — every one of those queries was doing a full
  // collection scan with no index at all. Compound indexes lead with
  // isDeleted (the one predicate every list/browse query shares) so Mongo
  // can use the same index across each of these filter combinations.
  @@index([isDeleted, category])
  @@index([isDeleted, isNewArrival])
  @@index([isDeleted, isBestSeller])
  @@index([isDeleted, brand])
  @@index([isDeleted, price])
}

model Order {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  // `total` remains the grand total (subtotal + deliveryCharge) and is
  // what payment.controller.js/shipping.service.js actually charge —
  // unchanged in meaning, just no longer equal to the item sum alone.
  total            Float
  // Breakdown fields, added alongside `total` rather than replacing it so
  // existing orders (which predate this rule) keep working: both are
  // optional and simply absent on old records. See
  // src/constants/pricing.js for how they're derived.
  subtotal         Float?
  deliveryCharge   Float?
  // Discount/coupon placeholder architecture: both fields are optional so
  // existing orders (predating this) keep working unchanged. `discount` is
  // always 0 today (see calculateDiscount in src/constants/pricing.js — no
  // Coupon model/admin management exists yet), but `total` is already wired
  // as subtotal + deliveryCharge - discount everywhere it's computed, so a
  // real coupon system can be dropped in later by making calculateDiscount
  // do real work, without touching how `total` itself is derived or spent
  // (payment.controller.js, shipping.service.js, etc. only ever read `total`).
  discount         Float?        @default(0)
  couponCode       String?
  addressId        String
  address          Address       @relation(fields: [addressId], references: [id])
  payment_order_id String?       @unique
  payment_id       String? // Razorpay payment id (pay_xxx) that actually paid this order, set by the webhook
  status           OrderStatus // e.g. 'pending', 'shipped', 'delivered', 'cancelled'
  paymentStatus    PaymentStatus @default(pending) // 'pending', 'paid', etc.
  orderItems       OrderItem[]
  createdAt        DateTime      @default(now())
  // Optional (rather than a plain required @updatedAt) so existing orders
  // predating this field keep working unchanged — same convention as
  // subtotal/deliveryCharge above. Used by reconcileStalePaymentAttempts
  // (payment.service.js) to find payment attempts that have gone stale.
  updatedAt        DateTime?     @updatedAt

  // order.service.js's getUserOrderHistory filters `{ userId, status: {
  // not: 'draft' } }`; getUserDraftOrder filters `{ userId, status:
  // 'draft' }`; the admin order list and admin.service.js's dashboard
  // counts filter by `status`/`paymentStatus` alone (with no userId) and
  // sort by createdAt — none of that had an index to use on what's one of
  // the two hottest collections in the app.
  @@index([userId, status])
  @@index([status, createdAt])
  @@index([paymentStatus])
}

model Cart {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  updatedAt DateTime @updatedAt

  // One row per (user, product) — makes "add to cart" an upsert instead of
  // insert-then-hope, and makes it structurally impossible for the same
  // product to appear twice in one user's cart (which duplicate createMany
  // calls, retries, or double-taps could otherwise produce).
  @@unique([userId, productId])
}

// Customer "save for later" list — deliberately separate from Cart (a
// wishlisted item isn't a purchase intent the way a cart line is, and
// carries no quantity). Same "one row per (user, product)" shape as Cart
// for the same reason: it makes adding an already-wishlisted product an
// upsert/no-op instead of a duplicate row, and makes membership a simple
// unique lookup for the frontend's heart-icon toggle state.
model Wishlist {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  rating    Int // e.g. 1 to 5
  comment   String
  createdAt DateTime @default(now())
}

model ContactQuery {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  email   String
  message String

  userId String? // Optional, since not all queries may be by registered users
  user   User?   @relation(fields: [userId], references: [id])
}

model OrderItem {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String
  productId String
  quantity  Int
  price     Float

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  // Every order-detail fetch loads its items by orderId (getOrderById,
  // the draft-order upsert's deleteMany/create pair); admin analytics and
  // best-seller aggregation join back through productId.
  @@index([orderId])
  @@index([productId])
}

model Banner {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl  String
  linkUrl   String?
  createdAt DateTime @default(now())
}

// Admin-editable storefront text, trilingual (English/Hindi/Marathi) — the
// same content-management need every static i18n string in
// frontend-improved/src/i18n/*.json has (a wording change otherwise
// requires a code change + redeploy, which is what this exists to avoid).
// `key` is a dotted path matching the i18n key it overrides (e.g.
// "ticker.cod" for advika.ticker.cod) so the frontend can look one up
// without a separate mapping table. Deliberately NOT one row per language —
// a single row per key keeps "edit this line in all three languages" one
// admin action instead of three separate ones, and makes it structurally
// impossible for a key to exist in one language but not another.
model SiteContent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  valueEn   String
  valueHi   String
  valueMr   String
  updatedAt DateTime @updatedAt
}

model Address {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  name                 String
  phone                String
  pincode              String
  city                 String
  houseArea            String
  // Locality / sector / colony — distinct from `houseArea` (house no.,
  // building, street). Optional at the schema level so pre-existing
  // addresses (created before this field existed) keep working unchanged;
  // enforced as required for new/edited addresses at the validation layer
  // (see user.validation.js).
  area                 String?
  state                String
  landmark             String?
  // Free-text note for the delivery agent (e.g. "leave with security",
  // "call before delivery"). Always optional.
  deliveryInstructions String?
  // Exactly one address per user has this set to true at any time — this
  // invariant is enforced in user.service.js (createAddress/updateAddressById/
  // setDefaultAddressById/deleteAddressById), never left to the client.
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  orders Order[]

  @@index([userId])
}

// Event-level webhook ledger — deliberately separate from Order's own
// order-level idempotency (payment.service.js's "paymentStatus: { not:
// 'paid' }" guards). That guard only dedupes the side effects of a single
// event *type* against the order's current state; it can't tell two
// deliveries of the exact same webhook event apart from two different
// events that both happen to resolve to a no-op, and it leaves no record of
// what Razorpay actually sent or when. This table is keyed on Razorpay's own
// x-razorpay-event-id header (unique per event — see
// https://razorpay.com/docs/webhooks/best-practices/), so a retried/resent
// delivery of the same event is recognized and skipped before any handler
// logic runs at all, and the raw payload is kept as an audit trail
// independent of whatever the order's row later gets overwritten with.
model WebhookEvent {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  // 'razorpay' today; kept as a field (not hardcoded) so another provider's
  // webhook (e.g. Ekart shipping) could reuse this table later without a
  // schema change — @@unique below is scoped per-source accordingly.
  source     String
  // Razorpay's x-razorpay-event-id header value.
  eventId    String
  eventType  String
  // Denormalized out of `payload` purely so a duplicate/audit lookup
  // doesn't need to inspect the JSON — the payload itself remains the
  // source of truth for these.
  orderId    String?
  paymentId  String?
  payload    Json
  receivedAt DateTime @default(now())

  // One record per (source, eventId) — this is what makes a duplicate
  // delivery detectable at all; see handleRazorpayWebhookEvent.
  @@unique([source, eventId])
  @@index([orderId])
}

// --- Shipping module (Ekart Logistics) ---
// No formal Prisma relation to Order is declared here on purpose, so
// adding this doesn't require touching the existing Order model — orderId
// is a plain reference, resolved manually in shipping.service.js.

enum ShipmentStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RTO_INITIATED
  RTO_DELIVERED
  CANCELLED
}

model Shipment {
  id                    String         @id @default(auto()) @map("_id") @db.ObjectId
  orderId               String         @unique // references Order.id
  trackingId            String?        @unique // Ekart tracking ID / AWB number, set once Ekart returns one
  awbNumber             String?
  courierPartner        String         @default("Ekart")
  status                ShipmentStatus @default(CREATED)
  paymentMode           String // 'COD' | 'PREPAID', copied from the order at creation time
  codAmount             Float          @default(0)
  pickupLocationCode    String?
  lastLocation          String?
  // Delivery-by estimate for this shipment. Set from Ekart's create-shipment
  // response at creation time (see createShipmentForOrder), and kept fresh
  // by trackOrderShipment / handleEkartWebhookEvent whenever Ekart returns a
  // refreshed one on a later poll or webhook (e.g. after a delay). Distinct
  // from the pre-shipment `estimatedDays`/`estimatedDeliveryDate` returned by
  // checkServiceability — that's a rough pre-order preview computed from an
  // SLA day-count; this is the real per-shipment estimate once one exists.
  estimatedDeliveryDate DateTime?
  lastSyncedAt          DateTime?
  raw                   Json? // last raw payload received from Ekart, kept for debugging
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}
